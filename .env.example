APP_TITLE=Movie Recommendation API
APP_VERSION=0.1.0
DATABASE_URL=postgresql+asyncpg://movie_app:movie_app2026@localhost:5432/movie_recommendation

# TMDB read-only catalog integration
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_READ_ACCESS_TOKEN=replace_with_your_tmdb_read_access_token
TMDB_TIMEOUT_SECONDS=5

# Logging configuration
# Valid levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
