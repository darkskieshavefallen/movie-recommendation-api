APP_TITLE=Movie Recommendation API
APP_VERSION=0.1.0
DATABASE_URL=postgresql+asyncpg://movie_app:movie_app2026@localhost:5432/movie_recommendation
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# Optional TMDB read-only catalog integration. The local API works when disabled.
TMDB_ENABLED=false
TMDB_BASE_URL=https://api.themoviedb.org/3
# Set both TMDB_ENABLED=true and a real token to enable external search.
TMDB_READ_ACCESS_TOKEN=
TMDB_TIMEOUT_SECONDS=5

# Logging configuration
# Valid levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
